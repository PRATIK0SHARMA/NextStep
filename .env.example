# Copy to .env. Never commit .env or put API keys in frontend files.
APP_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:8000
# Default database is data/nextstep.sqlite3. Leave this unset locally.
# DATABASE_PATH=C:/Users/sharm/OneDrive/Desktop/NEXTSTEP_COMPLETE/data/nextstep.sqlite3
ACCESS_CODE=
SESSION_DAYS=30

# demo: key-free deterministic simulator; no model call.
# compatible: OpenAI-compatible /chat/completions endpoint (e.g. Groq).
# ollama: native Ollama /api/chat endpoint.
LLM_PROVIDER=demo
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=30
